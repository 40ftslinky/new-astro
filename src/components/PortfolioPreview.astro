---
import { Image } from 'astro:assets';

const { data, id } = Astro.props.project;
const industries = Array.isArray(data.industries) ? data.industries.join(', ') : data.industries;
---

<a class="portfolio-preview" href={`/projects/${id}`} aria-label={`View ${data.title}`}>
	<div class="column info-wrap">
		<h3>{data.title}</h3>
		{industries && <p>{industries}</p>}
	</div>

	{data.cover ? (
		<div class="col_content">
			<div class=" image-wrap">
				<Image
					src={data.cover}
					width={data.coverWidth}
					height={data.coverHeight}
					alt={data.coverAlt || data.title}
				/>
			</div>
		</div>
	) : (
		<div class="image-wrap missing-image" aria-hidden="true"></div>
	)}
</a>

<style>
	.portfolio-preview {
		display: flex;
		align-items: stretch;
		justify-content: space-between;
		flex-direction: row;
		width: 100%;
		/* max-height: 55rem; */
		max-height: 80vh;
		overflow: hidden;
		/* border-radius: 0.625rem; */
		/* background: var(--gray-900); */
		background: transparent;
		color: var(--gray-100);
		text-decoration: none;
	}

	.info-wrap {
		flex: 0 1 calc((var(--max-col-width) / 3) - var(--col-gap));
		max-width: calc((var(--max-col-width) / 3) - var(--col-gap));
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.25rem;
		/* padding: 0.95rem; */
	}

	.info-wrap h3,
	.info-wrap p {
		margin: 0;
		padding-bottom: 0;
		font-family: var(--font-body);
	}
	

	.info-wrap h3 {
		font-size: clamp(1.125rem, 1.3vw, 1.375rem);
		line-height: 1.1;
		letter-spacing: 0;
		text-transform: uppercase;
		font-weight: 600;
		color: var(--gray-100);
	}

	.info-wrap p {
		font-size: var(--font-size-small);
		line-height: 1.1;
		font-weight: 400;
		letter-spacing: 0.001rem;
	}

	.image-wrap {
		flex: 0 1 var(--max-content-width);
		width: var(--max-content-width);
		max-width: var(--max-content-width);
		aspect-ratio: 1812 / 1018.5;
		overflow: hidden;
		/* border-radius: inherit; */
		border-radius: 0.625rem;
		background: var(--gray-800);
	}

	.image-wrap img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: grayscale(1);
		transition: transform 420ms ease-in-out, filter 420ms ease-in-out;
	}

	.portfolio-preview:hover img,
	.portfolio-preview:focus-visible img {
		transform: scale(1.025);
		filter: grayscale(0.65);
	}

	.portfolio-preview:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 3px;
	}

	@media (max-width: 80em) {
		.portfolio-preview { flex-direction: column; gap: 2rem; }
		.info-wrap,
		.image-wrap { width: 100%; max-width: 100%; }
		.info-wrap { order: 2; flex: unset;}
		.image-wrap { order: 1; }
	}
	@media (max-width: 34em) {
		/* .portfolio-preview { flex-direction: column; gap: 2rem; }
		.image-wrap { width: 100%; max-width: 100%; } */
	}

</style>
