---
import { Image } from 'astro:assets';

const { data, id } = Astro.props.project;
const industries = Array.isArray(data.industries) ? data.industries.join(', ') : data.industries;
---

<a class="portfolio-preview" href={`/projects/${id}`} aria-label={`View ${data.title}`}>
	<div class="column info-wrap">
		<h3>{data.title}</h3>
		{industries && <p>{industries}</p>}
	</div>

	{data.cover ? (
		<div class="col_content">
			<div class=" image-wrap">
				<Image
					src={data.cover}
					width={data.coverWidth}
					height={data.coverHeight}
					alt={data.coverAlt || data.title}
				/>
			</div>
		</div>
	) : (
		<div class="image-wrap missing-image" aria-hidden="true"></div>
	)}
</a>

