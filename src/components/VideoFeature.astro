---

import { videoHasAudio } from '../utils/videoHasAudio';
import { resolveMediaPath } from '../utils/resolveMediaPath';


const { frontmatter, video: videoProp } = Astro.props;
const video = videoProp ?? frontmatter?.video;
const videoPoster = resolveMediaPath(video?.poster);
const videoUrl = resolveMediaPath(video?.url);
const hasAudio = video?.hasAudio ?? await videoHasAudio(video?.url);


---

<div class="video_wrap">
	<video class="video"
		data-has-audio={hasAudio === undefined ? undefined : String(hasAudio)}
		muted
		playsinline
		width={video?.width ?? '100%'} 
		height={video?.height ?? '100%'} 
		transition:persist
		autoplay={false}
		loop={video?.loop ?? false}		
		poster={videoPoster}
	> 
		<source src={videoUrl} type="video/mp4" />
		Your browser does not support the video tag.
	</video>
</div>

<style>

	.video_wrap {
		position: relative;
		width: 100%;
		max-width: fit-content;
		height: auto;
		overflow: hidden;
	}

	.carousel_slide .video_wrap,
	.carousel_slide .video_wrap .video {
		max-width: 95vw;
	}

	.video {
		display: block;
		width: 100%;
		height: auto;
		object-fit: cover;
		border-radius: var(--border-radius);
	}

	.video_wrap :global(.video-audio-toggle) {
		position: absolute;
		bottom: 1rem;
		right: 1rem;
		z-index: 2;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 6px;
		border: 0;
		border-radius: 0;
		background: transparent;
		color: #fff;
		cursor: pointer;
	}
	.video_wrap :global(.video-audio-toggle svg) {
		display: block;
		width: 32px;
		height: 32px;
	}
	.video_wrap :global(.video-audio-toggle:focus-visible) {
		outline: 3px solid #fff;
		outline-offset: 3px;
	}
	@media (min-width: 1180px) {
		:root {
			--controls-size: 3rem;
		}
	}
	.video-controls-button,
	.video_wrap :global(.video-audio-toggle) {
		align-items: center;
		-webkit-backdrop-filter: blur(2rem);
		backdrop-filter: blur(2rem);
		background-color: rgba(0, 0, 0, .15);
		background-color: var(--controls-bg, rgba(0, 0, 0, .15));
		border: none;
		border-radius: 50%;
		color: #fff;
		color: var(--controls-color, #fff);
		cursor: pointer;
		display: flex;
		height: 2.4rem;
		height: var(--controls-size, 2.4rem);
		justify-content: center;
		min-width: 2.4rem;
		min-width: var(--controls-size, 2.4rem);
		outline: none;
		padding: .66rem;
		padding: calc(var(--controls-size, 2.4rem) * .275);
		width: 2.4rem;
		width: var(--controls-size, 2.4rem);
	}

	.video_wrap :global(.video-audio-toggle[hidden]),
	.video_wrap :global(.video[data-has-audio="false"] ~ .video-audio-toggle) {
		display: none !important;
	}

</style>
