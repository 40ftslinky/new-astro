---
interface Props {
	variant?: 'offset' | 'even' | 'small' | 'medium' | 'large';
}

const { variant } = Astro.props;
---

<ul class:list={['flex', { offset: variant === 'offset', even: variant === 'even', small: variant === 'small', medium: variant === 'medium', large: variant === 'large'  }]}>
	<slot />
</ul>

<style>
	.grid {
		display: grid;
		grid-template-columns: auto;
		grid-auto-rows: 1fr;
		gap: 2rem;
		list-style: none;
		padding: 0;
		margin-top: 4rem;
	}

	.flex {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
		list-style: none;
		padding: 0;
		margin-top: 4rem;
		width: 100%;
	}

	.flex > :global(*) {
		min-width: 0;
		width: 100%;
		max-width: 49%;
		flex-shrink: 0;
		flex-basis: auto;
	}

	.flex.small {
		
	}
	.clients .flex.small {
		gap: 10vw
	}

	/* If last row contains only one item, make it span both columns. */
	.flex.small > :global(:last-child:nth-child(odd)) {
		grid-column: 1 / 3;
	}
	

	.large .card {
		width: var(--max-col-width);
	}

	.flex.large .card  {
		height: var(--max-body-height);
		width: var(--max-col-width);
		max-width: unset;
	}
	
	#projects .flex.offset {
		justify-content: flex-start;
		gap: var(--col-gap);
	}

	#projects .flex.offset li,
	#projects .flex.offset > :global(li) {
		flex: 1 1 100%;
		max-width: 100%;
		width: 100%;
	}

	#projects .flex.offset :global(.card) {
		width: 100%;
		max-width: 100%;
	}

/* 800px */
	@media (min-width: 50em) {
		.flex {
			gap: 2rem;
		}		

		.flex.small {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			/* gap: 2rem; */
			gap: 4vw;
		}

		.flex.small > :global(*) {
			/* flex-basis: 20rem; */
			flex-basis: 10rem;
			max-width: 90vw;
		}

		.flex.medium {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 2rem;
			/* gap: 2vw; */
		}

		.flex.medium > :global(*) {
			/* flex-basis: 20rem; */
			flex-basis: 20%;
			max-width: 90vw;
			/* min-width: 90vw; */
		}

		.flex.large {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
			/* gap: 2vw; */
		}

		.flex.large > :global(*) {
			flex-basis: 100%;
			max-width: 90vw;
		}

		#projects .flex.offset li,
		#projects .flex.offset > :global(li) {
			flex: 0 1 calc((100% - var(--col-gap)) / 2);
			max-width: calc((100% - var(--col-gap)) / 2);
			width: calc((100% - var(--col-gap)) / 2);
		}

		#projects .flex.offset > :global(li:nth-child(odd)) {
			transform: translateY(4rem);
		}
	}

	@media screen and (max-width: 32.5em) {
		.flex.small {
			grid-template-columns: 1fr 1fr
	}

	
	
</style>
