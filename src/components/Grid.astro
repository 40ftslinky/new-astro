---
interface Props {
	variant?: 'offset' | 'even' | 'half' | 'small' | 'medium' | 'large' | 'related';
}

const { variant } = Astro.props;
---

<ul class:list={['project-grid', 'flex', { offset: variant === 'offset', even: variant === 'even', half: variant === 'half', small: variant === 'small', medium: variant === 'medium', large: variant === 'large', related: variant === 'related'  }]}>
	<slot />
</ul>
