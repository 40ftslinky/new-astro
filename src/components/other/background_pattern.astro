<!-- background pattern -->

---

<div class="pointer-events-none fixed inset-0 z-0 size-full overflow-hidden p-8 pr-[calc(2rem+var(--scrollbar-width))] mix-blend-difference">
    <div class="grid h-full grid-cols-4 gap-0 md:grid-cols-12" style="opacity: 1;">
        <div class="relative h-0 -translate-x-px -translate-y-px pt-[100%]">
            <div class="absolute left-0 top-0 size-0.5 rounded-full bg-white"></div>
            <div class="absolute left-0 top-full size-0.5 rounded-full bg-white"></div>
            <div class="absolute left-full top-0 size-0.5 rounded-full bg-white"></div>
            <div class="absolute left-full top-full size-0.5 rounded-full bg-white"></div>
        </div>
    
    </div>
</div>
<style>
    .top-full {
        top: 100%;
    }
    .left-full {
        left: 100%;
    }
</style>