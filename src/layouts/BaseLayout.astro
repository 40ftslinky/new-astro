---


// Components
// import Meta from '../components/Meta.astro';
import MainHead from '../components/MainHead.astro';
import Header from '../components/Header.astro';
import GlobalCTA from '../components/GlobalCTA.astro';
import Footer from '../components/Footer.astro';

// styles
import '../styles/styles.css';
// import '../styles/global.css';
// import '../styles/navigation.css';
// import '../styles/typography.css';
// import '../styles/colours.css';
// import '../styles/animations.css';


// props
const {
	uniqueID,
	pageTitle,
	metaTitle,
	metaDescription,
	metaImage,
	canonicalUrl,
	robots,
	noindex,
	showGlobalCTA = true,
} = Astro.props;


---



<html lang="en" data-page={uniqueID}>

<!-- Add the following <meta> tag in the <head> section of your HTML -->
	<meta http-equiv="Content-Type" content="text/css">

	<MainHead 
		pageTitle={pageTitle} 
		metaTitle={metaTitle} 
		metaDescription={metaDescription} 
		metaImage={metaImage}
		canonicalUrl={canonicalUrl}
		robots={robots}
		noindex={noindex}
	/>

	<body id={uniqueID} >
		<div class="noise" ></div>
		<div class="overlay_effect"></div>

		<!-- header -->
		<Header />

		<div id="container">
			<!-- <img id="background" src={background.src} alt="" fetchpriority="high" /> -->
			<main>

				

				<!-- slot -->
				<slot />
		
			</main>
		</div>

		<!-- global cta -->
		{showGlobalCTA && <GlobalCTA />}
		
		<Footer />

		<!-- // This code is inlined in the head to make it instant & blocking. -->
		<script is:inline>

		</script>
		
		<!-- relative path to script at `src/scripts/local.js` -->
		<!-- <script src="../scripts/scroll.js"></script> -->
	
		<script  >
			// document.querySelector('.hamburger')?.addEventListener('click', () => {
			//   document.querySelector('.nav-links')?.classList.toggle('expanded');
			// });
			import "../scripts/menu.js";
			import "../scripts/cursor.js";
			import "../scripts/gradient-rollover.js";
			import "../scripts/video-pause.js";
			import "../scripts/carousel.js";
			import "../scripts/scroll.js";
			import "../scripts/image-swap.js";
			// import "../scripts/pixel-trail.js";

		</script>  
	
	</body>


</html>

<style>
	:global(.pixel-trail) {
		position: fixed;
		inset: 0;
		z-index: 1000;
		pointer-events: none;
		image-rendering: pixelated;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
