---
import { getCollection } from "astro:content";
import BaseLayout from '../../layouts/BaseLayout.astro';
import { toSlug } from "../../utils/toSlug";
// import ProjectPost from '../../components/ProjectPost.astro';

// import Form from '../../components/Form.astro';
// import FeedbackForm from "../../components/FeedbackForm"



// const allProjects = await Astro.glob('../projects/*.md');
const allProjects = await getCollection("projects");
// const tags = ['astro', 'blogging', 'learning in public', 'successes', 'setbacks', 'community']
// const tags = [...new Set(allProjects.map((project) => project.frontmatter.tags).flat())];
const tags = [
	...new Set(
		allProjects
			.map((project) => project.data.tags)
			.flat()
			.filter((tag): tag is string => typeof tag === "string" && tag.length > 0)
	),
];

const uniqueID = "tag-index";
const pageTitle = "Tag Index";
const metaTitle = "Project Tags | 40ftSlinky";
const metaDescription = "Browse 40ftSlinky creative projects by capability, service and topic.";
const pageHead = "Tags Index";
const pageDesc = "A list of tagged projects";
const pageContent = "Select a tag to view all projects with that tag.";

---

<BaseLayout
	uniqueID={uniqueID}
	pageTitle={pageTitle} 
	metaTitle={metaTitle} 
	metaDescription={metaDescription}
	noindex={true}
	pageHead={pageHead} 
	pageDesc={pageDesc}
	pageContent={pageContent}
>

    <section>
		<div class="content">

            <div class="tags">
                {tags.map((tag) => (
					<p class="tag"><a href={`/tags/${toSlug(tag)}`}>{tag}</a></p>
                ))}
            </div>

        </div>

		<div class="contact">
            <!-- <FeedbackForm client:load /> -->
			<!-- <ContactCTA /> -->
		</div>

	</section>

</BaseLayout>

<style>
    
</style>
