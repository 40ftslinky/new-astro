---
// layout
import BaseLayout from '../layouts/BaseLayout.astro';

// components
import { fade } from "astro:transitions";
import Bio from '../components/Bio.astro';
import Services from '../components/Services.astro';
import Howwedoit from '../components/Howwedoit.astro';

// content
const uniqueID = "about";
const pageTitle = "About";
const metaTitle = "About meta Title tbc";
const metaDescription = "About page meta description tbc";
const pageHead = "Small footprint, big steps.";
const pageDesc = "40ftSlinky is a multidisciplinary agency for brand, digital and content work. We build clear strategies, distinctive identities and practical digital systems for organisations that need their communications to perform.";
const pageContent = "About page content tbc";

---

<BaseLayout
	uniqueID={uniqueID}
	pageTitle={pageTitle}
	metaTitle={metaTitle}
	metaDescription={metaDescription}
	pageHead={pageHead}
	pageDesc={pageDesc}
	pageContent={pageContent}
>
	<section class="about">
		<div class="row ">
			<div class="column ">
				<h1 class="text-gradient" transition:animate={fade({ duration: '1s' })} >{pageHead}</h1>
				<h2 class="subtitle">{pageDesc}</h2>
			</div>
		</div>
	</section>

	<section class="animate fade-up">
		<div class="row has-divider">
			<div class="column col_title">

				<h2>Who we are</h2>

			</div>

			<div class="column col_content  fade-up">

				<div class="content">

					<p>40ftSlinky works with commercial, government and cultural organisations across Australia and overseas. We bring strategy, design, development and production together so ideas can move cleanly from direction to delivery.</p>

					<p>Our model is deliberately lean. We assemble senior teams around each brief, drawing on trusted specialists across brand, product, content, motion and technology. You get the thinking and craft your project needs without the weight of a large agency structure.</p>

					<p>We are the team you need when a project needs clear positioning, sharper identity, a better digital experience, or the content and systems to support growth. Our work is practical, considered and built to last beyond launch.</p>

				</div>


				<!-- <div class="content fade-up">

					<blockquote>
						<p>“It may well be that creativity is the last unfair advantage we're legally allowed to take over our competitors.”</p>
						<credit>Bill Bernbach</credit>
					</blockquote>
				</div> -->

				<!-- <div class="content fade-up">

					<blockquote>
						<p>“Using the absurd to illustrate the absurdity.”</p>
						<credit>Unknown</credit>
					</blockquote>
				</div> -->

			</div>
			<!-- / col -->
		</div>
		<!-- / row -->
	</section>

	<Bio></Bio>

	<Services></Services>

	<Howwedoit></Howwedoit>

</BaseLayout>

<style>
	h1 {
		max-width: 12ch;
	}

	.portrait_wrap {
		/* display: flex;
		justify-content: center;
		align-items: center; */
		aspect-ratio: 1/1;
		width: 30vw;
		height: 30vw;
		overflow: hidden;
		margin-bottom: 4rem;
	}

	.portrait {
		border-radius: 0;
		max-width: unset;
		width: 30vw;
		/* height: 30vw; */
	}

	.content {
		margin: 2rem 0;
	}

	ul {
		list-style-type: none;
	}

	ul li {
		margin: 0.5rem 0;
	}

	ul li.checkmark::before {
		content: "✔️ ";
	}

	ul li.cross::before {
		content: "❌ ";
	}

	blockquote {
		font-style: italic;
		font-size: 2.25vw;
		line-height: 1.5;
		margin: 2rem 0;
		max-width: 30ch;
	}
	blockquote p {
		text-indent: -1rem;
	}

	.platform-group {
		gap: 2rem;
	}
	/* h4 {
		margin-top: 6rem;
		padding-bottom: 0;
	}
	.partners {
	} */

	</style>
